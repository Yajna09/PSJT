class Solution {

    public boolean repeatedSubstringPattern(String s) {
        int n = s.length();

        int[] lps = new int[n];

        // Build the LPS (Longest Prefix Suffix) array
        int len = 0;
        int i = 1;

        while (i < n) {
            if (s.charAt(i) == s.charAt(len)) {
                lps[i] = ++len;
                i++;
            } else {
                if (len > 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        // Length of the longest proper prefix
        // which is also a suffix
        int longestPrefixSuffix = lps[n - 1];

        // Length of the repeating part
        int patternLength = n - longestPrefixSuffix;

        // The string must be completely divisible
        // by the repeating pattern length.
        return longestPrefixSuffix > 0
                && n % patternLength == 0;
    }
}
