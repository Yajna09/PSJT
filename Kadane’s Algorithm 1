import java.io.*;
import java.util.*;

public class Solution {

    public static List<Integer> maxSubarray(List<Integer> arr) {

        // Kadane's algorithm for maximum subarray
        int maxSubarray = arr.get(0);
        int currentSum = arr.get(0);

        // Maximum subsequence
        int maxSubsequence = arr.get(0);

        for (int i = 1; i < arr.size(); i++) {
            int value = arr.get(i);

            // Maximum subarray
            currentSum = Math.max(value, currentSum + value);
            maxSubarray = Math.max(maxSubarray, currentSum);

            // Maximum subsequence
            // Add only positive values
            if (value > 0) {
                maxSubsequence += value;
            }
        }

        // If all values are negative, choose the largest (least negative)
        if (maxSubsequence <= 0) {
            maxSubsequence = arr.get(0);

            for (int i = 1; i < arr.size(); i++) {
                maxSubsequence = Math.max(maxSubsequence, arr.get(i));
            }
        }

        return Arrays.asList(maxSubarray, maxSubsequence);
    }

    public static void main(String[] args) throws IOException {

        BufferedReader br = new BufferedReader(
                new InputStreamReader(System.in)
        );

        int t = Integer.parseInt(br.readLine().trim());

        StringBuilder output = new StringBuilder();

        while (t-- > 0) {

            int n = Integer.parseInt(br.readLine().trim());

            String[] input = br.readLine().trim().split(" ");

            List<Integer> arr = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                arr.add(Integer.parseInt(input[i]));
            }

            List<Integer> result = maxSubarray(arr);

            output.append(result.get(0))
                   .append(" ")
                   .append(result.get(1))
                   .append("\n");
        }

        System.out.print(output);

        br.close();
    }
}
